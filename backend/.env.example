# Ambalaj Çırak Asistanı — Backend Ortam Değişkenleri
# Bu dosyayı doldurun ve .env olarak kaydedin

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google Gemini (Ücretsiz tier için)
GEMINI_API_KEY=your_gemini_api_key

# Döviz Kuru API (https://www.exchangerate-api.com — ücretsiz)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Uygulama
APP_SECRET_KEY=gizli_bir_anahtar_buraya_yazin
DEBUG=true
PORT=8000
